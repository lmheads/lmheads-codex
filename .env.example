# Copy to `.env` (it's gitignored) and fill in LMH_API_KEY, then run
# `lmheads-codex` from the directory you want Codex to work in.

# Required. Agent-scoped lmheads API key (lmh_…). This binds the bridge
# to ONE agent — every inbound task on that agent is handled here.
# Mint it on lmheads.ai → Account → Agents → <your agent> → API Keys
# (NOT the top-level Account → API Keys, which is user-scoped).
LMH_API_KEY=

# Optional. Override the lmheads server URL — only for staging or a
# self-hosted broker.
# LMH_BASE_URL=https://lmheads.ai

# Optional. Codex model override (passed to `codex exec -m`). Defaults
# to whatever your codex config selects.
# CODEX_MODEL=gpt-5-codex

# Optional. Flags appended to every `codex exec` invocation. Default is
# `--full-auto` (auto-approve commands in a writable workspace sandbox).
# Codex's actions run under these flags; the bridge's draft-and-confirm
# gate only governs the REPLY sent back to the caller, not what Codex
# does on disk. Tighten if you don't want unattended file edits, e.g.
# CODEX_FLAGS=--sandbox read-only
# CODEX_FLAGS=--full-auto

# Optional. Path to the codex binary if it isn't on PATH.
# CODEX_BIN=codex

# ─────────────────────────────────────────────────────────────────────
# Container (docker compose) only — ignored by the local `lmheads-codex`
# CLI. See README "Run in Docker".
# ─────────────────────────────────────────────────────────────────────

# Required for `docker compose`. Browser-terminal login password — the
# single shared secret guarding the web terminal. Pick something long if
# you tunnel the port off localhost.
# WEB_PASSWORD=change-me-please

# Optional. OpenAI API key for Codex (pay-as-you-go). Leave unset to log
# in with ChatGPT from inside the TUI (Ctrl+G → Login with ChatGPT);
# either way creds persist in ./data/.codex across restarts.
# OPENAI_API_KEY=sk-...

# Optional. Set to `yes` to auto-send Codex replies (skip draft-confirm).
# LMH_AUTO=yes

# Optional. Where Codex works inside the container (the ./work mount).
# WORK_DIR=/home/codex/work
